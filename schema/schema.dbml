// Admin

Table "roles" {
  "id" uint [pk, not null, increment]
  "role_name" varchar(50) [not null, unique]

  "created_at" datetime [not null, default: `now()`]
  "created_by" uint [ref: > users.id]
  "updated_at" datetime
  "updated_by" uint [ref: > users.id]
  "deleted_at" datetime
  "deleted_by" uint [ref: > users.id]

  Indexes {
    "deleted_at" [name: 'idx_roles_deleted_at']
  }
}

Table "permissions" {
  "id" uint [pk, not null, increment]
  "permission_name" varchar(100) [not null, unique]

  "created_at" datetime [not null, default: `now()`]
  "created_by" uint [ref: > users.id]
  "updated_at" datetime
  "updated_by" uint [ref: > users.id]
  "deleted_at" datetime
  "deleted_by" uint [ref: > users.id]

  Indexes {
    "deleted_at" [name: 'idx_permissions_deleted_at']
  }
}

Table "users" {
  "id" uint [pk, not null, increment]
  "username" varchar(50) [not null, unique]
  "password" varchar(255) [not null]
  "role_id" uint [default: 2, ref: > roles.id]

  "created_at" datetime [not null, default: `now()`]
  "created_by" uint [ref: > users.id]
  "updated_at" datetime
  "updated_by" uint [ref: > users.id]
  "deleted_at" datetime
  "deleted_by" uint [ref: > users.id]

  Indexes {
    "role_id" [name: 'idx_users_role_id']
    "deleted_at" [name: 'idx_users_deleted_at']
  }
}

Table "role_permissions" {
  "role_id" uint [not null, ref: > roles.id]
  "permission_id" uint [not null, ref: > permissions.id]

  "created_at" datetime [not null, default: `now()`]
  "created_by" uint [ref: > users.id]
  "updated_at" datetime
  "updated_by" uint [ref: > users.id]
  "deleted_at" datetime
  "deleted_by" uint [ref: > users.id]

  Indexes {
    (role_id, permission_id) [pk]
    "permission_id" [name: 'idx_role_permissions_permission_id']
    "deleted_at" [name: 'idx_role_permissions_deleted_at']
  }
}


// Main

Table "participants" {
  "id" bigint [pk, increment]
  "unique_id" varchar(255) [unique, not null]
  "full_name" varchar(255) [not null]
  "no_hp" varchar(20) [default: null]
  "email" varchar(255) [default: null]
  "unit_kerja" varchar(255) [not null]
  "nip" varchar(255) [not null]
  "prize" text [default: null]
  "sesi" uint(2) [default: null]
  "babak" uint(2) [default: null]
  "profile_picture" text [default: null]
  "line" varchar(255) [default: null]
  "status" varchar(100) [default: null]
  "registered_at" varchar(24) [default: null, note: "Canonical ISO 8601 UTC"]
  "verified_at" varchar(24) [default: null, note: "Canonical ISO 8601 UTC"]
  "is_invalid" bool [not null, default: false] // if true, then not the winner

  "created_at" timestamp [not null, default: `now()`]
  "updated_at" timestamp [default: null]
  "deleted_at" timestamp [default: null]

  Indexes {
    "created_at" [name: 'idx_user_data_created_at']
    (deleted_at, is_invalid, id) [name: 'idx_participants_valid_page']
    (deleted_at, is_invalid, babak, id) [name: 'idx_participants_valid_round']
    (deleted_at, is_invalid, sesi, babak, id) [name: 'idx_participants_valid_session_round']
    (deleted_at, id) [name: 'idx_participants_status_id']
    (deleted_at, babak, id) [name: 'idx_participants_status_round_id']
    (deleted_at, line, id) [name: 'idx_participants_line_page']
    (deleted_at, status, id) [name: 'idx_participants_status_page']
    (deleted_at, sesi, id) [name: 'idx_participants_status_session_id']
    (deleted_at, sesi, babak, id) [name: 'idx_participants_status_session_round_id']
  }
}

Table "system_settings" {
  "id" uint [pk, not null, increment]
  "logo_url" varchar(255) [not null, default: "/abracodebra.svg"]
  "login_bg_color" varchar(50) [not null, default: "#f3f4f6"]
  "login_bg_image" varchar(2048) [default: null]
  "updated_at" datetime [default: null, note: 'ON UPDATE current_timestamp()']
}
