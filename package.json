{
  "name": "mk26-doorprize-admin",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "db:migrate": "node scripts/database.js migrate",
    "db:seed": "node scripts/database.js seed",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "format": "prettier --write src config migrations seeds scripts tests docs *.js *.json README.md",
    "format:check": "prettier --check src config migrations seeds scripts tests docs *.js *.json README.md",
    "test:mysql": "MYSQL_TEST=1 node --test tests/*.test.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "@solidjs/router": "^0.16.0",
    "@solidjs/start": "2.0.5",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.0.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.0.0",
    "exceljs": "^4.4.0",
    "jose": "^6.0.0",
    "knex": "^3.1.0",
    "mysql2": "^3.14.0",
    "solid-js": "^1.9.15",
    "yauzl": "^3.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "eslint": "^10.11.0",
    "eslint-plugin-solid": "^0.18.0",
    "globals": "^17.12.0",
    "nitro": "3.0.260903-beta",
    "prettier": "^3.9.9",
    "vite": "^8.0.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
