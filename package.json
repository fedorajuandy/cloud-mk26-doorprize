{
  "name": "mk26-doorprize-admin",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/database.ts migrate",
    "db:seed": "tsx scripts/database.ts seed",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src database scripts tests vite.config.ts playwright.config.ts tsconfig.json package.json README.md",
    "format:check": "prettier --check src database scripts tests vite.config.ts playwright.config.ts tsconfig.json package.json README.md",
    "test:mysql": "MYSQL_TEST=1 tsx --test tests/api.test.ts"
  },
  "dependencies": {
    "@solidjs/router": "^0.16.0",
    "@solidjs/start": "2.0.5",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.0.0",
    "dotenv": "^17.0.0",
    "jose": "^6.0.0",
    "knex": "^3.1.0",
    "mysql2": "^3.14.0",
    "solid-js": "^1.9.15",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "nitro": "3.0.260903-beta",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
